{
  "name": "@toijs/typeorm",
  "version": "1.0.7",
  "private": false,
  "type": "module",
  "description": "TypeORM integration for @toijs/modular (DataSource, MySQL helpers, module)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@toijs/modular": "^1.0.0",
    "mysql2": "^3.23.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3"
  }
}
