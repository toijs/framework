{
  "name": "@toijs/graphql-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GraphQL integration for @toijs/modular",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "@toijs/modular": "*",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "graphql": "^16.14.2",
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3"
  }
}
