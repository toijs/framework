{
  "name": "@toijs/modular",
  "version": "1.0.5",
  "private": false,
  "type": "module",
  "description": "Isomorphic TypeScript composition pattern: modules, explicit DI, and Shell for Node.js and browser apps (Express, Vue, React, …)",
  "keywords": [
    "isomorphic",
    "browser",
    "nodejs",
    "typescript",
    "dependency-injection",
    "di",
    "container",
    "module",
    "modular",
    "ioc",
    "composition",
    "launcher",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toijs/framework.git",
    "directory": "modular"
  },
  "homepage": "https://github.com/toijs/framework/tree/develop/modular",
  "bugs": {
    "url": "https://github.com/toijs/framework/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3"
  }
}
