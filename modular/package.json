{
  "name": "@toijs/modular",
  "version": "1.0.2",
  "private": false,
  "type": "module",
  "description": "Lamtoi modular core (launcher, metadata, config, task, router)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3"
  }
}
